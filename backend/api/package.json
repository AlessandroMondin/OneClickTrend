{
  "name": "@oneclicktrend/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "docker compose up -d --wait && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "tsx src/pipeline/cli.ts check",
    "fetch": "tsx src/pipeline/cli.ts fetch",
    "download": "tsx src/pipeline/cli.ts download",
    "character": "tsx src/pipeline/cli.ts character",
    "render": "tsx src/pipeline/cli.ts render",
    "pipeline": "tsx src/pipeline/cli.ts pipeline",
    "check-v2": "tsx src/pipeline/cli.ts check-v2",
    "render-v2": "tsx src/pipeline/cli.ts render-v2",
    "pipeline-v2": "tsx src/pipeline/cli.ts pipeline-v2",
    "compare-v2": "tsx src/pipeline/cli.ts compare-v2",
    "smoke": "tsx src/pipeline/cli.ts smoke",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@oneclicktrend/database": "workspace:*",
    "@runwayml/sdk": "^4.13.1",
    "apify-client": "^2.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
