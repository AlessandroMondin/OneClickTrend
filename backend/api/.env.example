PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/oneclicktrend"
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
# Rewritten by `make configure-api` with the Mac's LAN IP so the phone can
# reach presigned upload URLs.
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_BUCKET=oneclicktrend-media

# Render pipeline (Animate)
# https://console.apify.com/settings/integrations
APIFY_TOKEN=
# https://portal.viggle.ai/keys
VIGGLE_API_KEY=
# Optional overrides
# APIFY_ACTOR_ID=GdWCkxBtKWOsKjdch
# VIGGLE_BASE_URL=https://apis.viggle.ai
